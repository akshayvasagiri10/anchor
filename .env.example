# Copy to .env. The backend loads this automatically.
#
# Anchor ships pointing at LM Studio on your own machine, so a fresh clone
# answers questions with no API key, no network, and no cost. Change
# ANCHOR_LLM_PROVIDER to move generation somewhere else.

# ─── Generation ────────────────────────────────────────────────────────────
# lmstudio | ollama | groq | openrouter | openai | anthropic
ANCHOR_LLM_PROVIDER=lmstudio

# Blank = use the provider's default. For lmstudio, blank auto-detects
# whichever model you have loaded in the GUI.
# ANCHOR_LLM_MODEL=

# Blank = the provider's standard endpoint. Override to reach a runtime on
# another host, e.g. http://192.168.1.50:11434/v1
# ANCHOR_LLM_BASE_URL=

# ── Keys — only needed for hosted providers ──
# Local providers (lmstudio, ollama) need none of these.
# GROQ_API_KEY=gsk_...                 # console.groq.com — free tier
# OPENROUTER_API_KEY=sk-or-...         # openrouter.ai — has :free models
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ANCHOR_MAX_TOKENS=2048
# ANCHOR_TEMPERATURE=0.2
# ANCHOR_EFFORT=low                    # Anthropic only: low|medium|high|xhigh|max

# ─── Retrieval ─────────────────────────────────────────────────────────────
# ANCHOR_CHUNK_SIZE=1200
# ANCHOR_CHUNK_OVERLAP=200
# ANCHOR_RETRIEVAL_TOP_K=6
# ANCHOR_CANDIDATE_POOL=30
# ANCHOR_RRF_K=60

# ANCHOR_EMBEDDINGS_ENABLED=true       # false -> BM25-only, no model download
# ANCHOR_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Server ────────────────────────────────────────────────────────────────
# ANCHOR_DB_PATH=data/anchor.db
# ANCHOR_CORS_ORIGINS=http://localhost:3000
